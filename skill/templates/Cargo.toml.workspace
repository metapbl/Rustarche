# Root Cargo.toml (virtual manifest). Crates live under crates/.
# Create crates with cargo new crates/<name>; edition and rust-version inheritance and [lints] workspace = true are added automatically.
[workspace]
members = ["crates/*"]
resolver = "3" # must be written explicitly in a virtual manifest

[workspace.package]
edition = "2024"
rust-version = "1.100"

[workspace.dependencies]

[workspace.lints.rust]
unsafe_code = "forbid" # lift it only in the crate that needs unsafe

[workspace.lints.clippy]
all = { level = "warn", priority = -1 }
pedantic = { level = "warn", priority = -1 } # allow noisy lints with a reason
# never the whole restriction group; pick lints from it
unwrap_used = "warn"                  # allowed in tests via clippy.toml
allow_attributes_without_reason = "warn"
wildcard_enum_match_arm = "warn"      # match your own enums without _
dbg_macro = "warn"
todo = "warn"
map_err_ignore = "warn"
clone_on_ref_ptr = "warn"
undocumented_unsafe_blocks = "warn"

[workspace.lints.cargo]
unused_dependencies = "warn" # 1.100 or later

# Faster edit loop: less debug info. Add a separate profile when a debugger is needed.
[profile.dev]
debug = "line-tables-only"

[profile.dev.package."*"]
debug = false
