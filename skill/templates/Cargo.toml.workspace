# 루트 Cargo.toml (가상 매니페스트). crate는 crates/ 아래에 둔다.
# crate는 cargo new crates/<이름>으로 만든다. edition·rust-version 상속과 [lints] workspace = true가 자동으로 들어간다.
[workspace]
members = ["crates/*"]
resolver = "3" # 가상 매니페스트에서는 직접 적어야 한다

[workspace.package]
edition = "2024"
rust-version = "1.100"

[workspace.dependencies]

[workspace.lints.rust]
unsafe_code = "forbid" # unsafe가 필요한 crate만 그 crate에서 푼다

[workspace.lints.clippy]
all = { level = "warn", priority = -1 }
pedantic = { level = "warn", priority = -1 } # 소음이 큰 lint는 이유를 달아 allow
# restriction 그룹 전체는 켜지 않고 골라서 켠다
unwrap_used = "warn"                  # 테스트는 clippy.toml에서 허용
allow_attributes_without_reason = "warn"
wildcard_enum_match_arm = "warn"      # 자기 enum은 _ 없이 match
dbg_macro = "warn"
todo = "warn"
map_err_ignore = "warn"
clone_on_ref_ptr = "warn"
undocumented_unsafe_blocks = "warn"

[workspace.lints.cargo]
unused_dependencies = "warn" # 1.100 이상

# 편집 루프를 빠르게: 디버그 정보를 줄인다. 디버거가 필요하면 그때 따로 프로필을 둔다.
[profile.dev]
debug = "line-tables-only"

[profile.dev.package."*"]
debug = false
